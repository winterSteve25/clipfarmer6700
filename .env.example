# Configure the key for the provider selected in clipfarmer.toml.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required only when enabling the corresponding publisher.
YOUTUBE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=

# Optional custom S3-compatible endpoint. AWS credentials use the AWS CLI credential chain.
S3_ENDPOINT=
