{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "twitch-capture",
  "version": "0.1.0",
  "identifier": "com.cadenz.twitch-capture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipFarmer — Editorial Console",
        "width": 1380,
        "height": 900,
        "minWidth": 820,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/scribble-models/": "scribble-models/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
